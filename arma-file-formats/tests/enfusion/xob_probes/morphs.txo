     5 0 4
     2 0 5
     1 0 1
     4 0 0
     5 0 4
     1 0 1
     7 0 6
     4 0 0
     3 0 3
     6 0 7
     7 0 6
     3 0 3
     8 0 8
     5 0 4
     4 0 0
