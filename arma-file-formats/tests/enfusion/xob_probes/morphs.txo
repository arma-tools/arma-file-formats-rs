      4 0 0.5 0
     
    }
    $morph "skew" {
      0 0.25 0 0
      2 -0.125 0 0
      4 0 0.5 0
     
    }
    $morph "scale" {
      0 -0.5 0 -0.5
      1 0 0 -0.5
      2 0.5 0 -0.5
      3 -0.5 0 0
      5 0.5 0 0
      6 -0.5 -0 0.5
      7 0 -0 0.5
      8 0.5 -0 0.5
     
    }
   }
  }
 }
}
